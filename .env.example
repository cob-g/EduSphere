# Copy to .env.local for local development. Never commit real values.
#
# NEXT_PUBLIC_* variables are inlined into the build, so on Railway they must be
# set as service variables before the build runs (a change requires a redeploy).

# Canonical public URL of this website. Used for metadata, robots.txt and sitemap.xml.
# Falls back to http://localhost:3000 when unset.
# Production example: https://edusphere.ai
NEXT_PUBLIC_SITE_URL=

# URL of the EduSphere school platform (separate Laravel app). Reserved for
# future sign-in / "Open app" links; not read by the code yet.
# Production example: https://app.edusphere.ai
NEXT_PUBLIC_APP_URL=
